# Copia este archivo como .env (en la misma carpeta) y ajusta los valores si hace falta.
# El archivo .env real no se sube a Git (está en .gitignore).

# Puerto del backend (Express)
PORT=3001

# Origen permitido por CORS (el frontend de Vite en desarrollo)
CLIENT_ORIGIN=http://localhost:5173

# Ollama: API local que reenvía las peticiones del modelo cloud a ollama.com
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gpt-oss:20b-cloud

# Nivel de razonamiento interno de gpt-oss: low | medium | high (vacío = el predeterminado de Ollama).
# "low" responde más rápido, ideal para la demo. El razonamiento interno NUNCA se muestra al estudiante.
OLLAMA_THINK=low

# Tiempo máximo de espera por respuesta del modelo (milisegundos)
OLLAMA_TIMEOUT_MS=90000

# Máximo de mensajes al tutor por minuto y por equipo
TUTOR_RATE_LIMIT_PER_MINUTE=20
